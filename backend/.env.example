PORT=5000
MONGODB_URI=mongodb+srv://<database_user>:<database_password>@<cluster-host>/complain_management_system?retryWrites=true&w=majority
# Optional comma-separated DNS servers for MongoDB SRV lookups (defaults to Cloudflare and Google DNS).
MONGODB_DNS_SERVERS=1.1.1.1,8.8.8.8
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRE=30d
CLIENT_URL=http://localhost:5173
# Optional comma-separated trusted proxy IPs/CIDRs, used to resolve client IPs behind a proxy.
TRUST_PROXY=
GEMINI_API_KEY=replace_with_your_gemini_api_key
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_gmail_app_password
SMTP_FROM=your_email@gmail.com